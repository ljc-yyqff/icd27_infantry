# A-board CH340 confirmed by hot-plug test on 2026-09-22.
# Match the adapter revision as well as VID/PID because this NUC has another
# CH340 device with the same VID/PID but a different bcdDevice value.
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="7523", ATTRS{bcdDevice}=="0264", SYMLINK+="gimbal", GROUP="dialout", MODE="0660", TAG+="systemd"
